<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>BgFree</RootNamespace>
    <AssemblyName>BgFree</AssemblyName>
    <!-- ponytail: HDT auto-update renames app-* dir; when build breaks, pass -p:HdtDir=... or bump this line -->
    <HdtDir Condition="'$(HdtDir)' == ''">$(LOCALAPPDATA)\HearthstoneDeckTracker\app-1.58.0</HdtDir>
    <!-- DLL lands where HDT picks plugins up. Close HDT before building: the loaded copy is locked. -->
    <OutDir>$(APPDATA)\HearthstoneDeckTracker\Plugins\BgFree\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="setup/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HdtDir)\HearthstoneDeckTracker.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HdtDir)\HearthDb.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HearthMirror">
      <HintPath>$(HdtDir)\HearthMirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(HdtDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HSReplay">
      <HintPath>$(HdtDir)\HSReplay.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
